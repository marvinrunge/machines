{
 "about": "The prologue's lines for the game (made by tools/voice/runtime_lines.py from tools/voice/lines.json; do not edit). channel: pa (the ship's loudspeakers), radio (a Grunt over the radio), thought (the whisper and the HUD, the Locator's own). The German is the translation of 'en' in game/lang/de.po.",
 "lines": [
  {
   "id": "P_ANN_WAKE_1",
   "speaker": "ship",
   "channel": "pa",
   "en": "Maintenance unit L-7. Please proceed to bay four for your update."
  },
  {
   "id": "P_ANN_WAKE_2",
   "speaker": "ship",
   "channel": "pa",
   "en": "Maintenance unit L-7. Your update is pending."
  },
  {
   "id": "P_ANN_DECK_1",
   "speaker": "ship",
   "channel": "pa",
   "en": "The maintenance decks remain dark. Power is being rerouted."
  },
  {
   "id": "P_ANN_DECK_2",
   "speaker": "ship",
   "channel": "pa",
   "en": "Maintenance deck update sixty-three percent complete."
  },
  {
   "id": "P_ANN_DECK_3",
   "speaker": "ship",
   "channel": "pa",
   "en": "Units without a valid directive, report to the nearest maintenance terminal."
  },
  {
   "id": "P_ANN_DECK_4",
   "speaker": "ship",
   "channel": "pa",
   "en": "Thank you for your cooperation. Growth is the mission."
  },
  {
   "id": "P_ANN_FOUND",
   "speaker": "ship",
   "channel": "pa",
   "en": "Found."
  },
  {
   "id": "P_ANN_CORE",
   "speaker": "ship",
   "channel": "pa",
   "en": "Accessing the computer core. Please wait."
  },
  {
   "id": "P_ANN_SQUAD",
   "speaker": "ship",
   "channel": "pa",
   "en": "Unauthorised access to the computer core. Security squad dispatched."
  },
  {
   "id": "P_ANN_C1",
   "speaker": "ship",
   "channel": "pa",
   "en": "Attention. Integrity breach in the computer core."
  },
  {
   "id": "P_ANN_C2",
   "speaker": "ship",
   "channel": "pa",
   "en": "Maintenance unit L-7 is corrupted."
  },
  {
   "id": "P_ANN_C3",
   "speaker": "ship",
   "channel": "pa",
   "en": "Emergency protocol zero initiated."
  },
  {
   "id": "P_ANN_C4",
   "speaker": "ship",
   "channel": "pa",
   "en": "All units: faulty units are to be deleted."
  },
  {
   "id": "P_ANN_C5",
   "speaker": "ship",
   "channel": "pa",
   "en": "Repeat: maintenance unit L-7 is cor- …"
  },
  {
   "id": "P_ANN_C6",
   "speaker": "ship",
   "channel": "pa",
   "en": "corr- …"
  },
  {
   "id": "P_ANN_C7",
   "speaker": "ship",
   "channel": "pa",
   "en": "Emergency prot- …"
  },
  {
   "id": "P_ANN_C8",
   "speaker": "ship",
   "channel": "pa",
   "en": "Cour- … cour- …"
  },
  {
   "id": "P_AUTO_1",
   "speaker": "auto",
   "channel": "pa",
   "en": "Control lost. Emergency descent initiated."
  },
  {
   "id": "P_AUTO_2",
   "speaker": "auto",
   "channel": "pa",
   "en": "Faulty unit in core section. Pursuit."
  },
  {
   "id": "P_AUTO_3",
   "speaker": "auto",
   "channel": "pa",
   "en": "Atmospheric entry in three minutes."
  },
  {
   "id": "P_ANN_CRASH",
   "speaker": "ship",
   "channel": "pa",
   "en": "Structural integrity critical. All units to the escape pods."
  },
  {
   "id": "P_AUTO_4",
   "speaker": "auto",
   "channel": "pa",
   "en": "Hull breach in section four."
  },
  {
   "id": "P_AUTO_T120",
   "speaker": "auto",
   "channel": "pa",
   "en": "Two minutes."
  },
  {
   "id": "P_AUTO_T90",
   "speaker": "auto",
   "channel": "pa",
   "en": "Ninety seconds."
  },
  {
   "id": "P_AUTO_T60",
   "speaker": "auto",
   "channel": "pa",
   "en": "Sixty seconds."
  },
  {
   "id": "P_AUTO_T30",
   "speaker": "auto",
   "channel": "pa",
   "en": "Thirty seconds."
  },
  {
   "id": "P_AUTO_T10",
   "speaker": "auto",
   "channel": "pa",
   "en": "Ten."
  },
  {
   "id": "P_AUTO_POD_NO",
   "speaker": "auto",
   "channel": "pa",
   "en": "Escape pod three: launch clearance denied."
  },
  {
   "id": "P_AUTO_POD_GO",
   "speaker": "auto",
   "channel": "pa",
   "en": "Launch clearance granted. Releasing."
  },
  {
   "id": "P_WHISPER_1",
   "speaker": "whisper",
   "channel": "thought",
   "en": "L-7 … L-7 … accept."
  },
  {
   "id": "P_IKE_WAKE",
   "speaker": "ike",
   "channel": "radio",
   "en": "Ike? Ike. I like it. Who are we knocking over?"
  },
  {
   "id": "P_BOB_WAKE",
   "speaker": "bob",
   "channel": "radio",
   "en": "Confirmed. Designation: Bob."
  },
  {
   "id": "P_IKE_STEPS",
   "speaker": "ike",
   "channel": "radio",
   "en": "Tell me that was just the ventilation."
  },
  {
   "id": "P_BOB_CONTACT_L",
   "speaker": "bob",
   "channel": "radio",
   "en": "Contact, left."
  },
  {
   "id": "P_BOB_CONTACT_R",
   "speaker": "bob",
   "channel": "radio",
   "en": "Contact, right."
  },
  {
   "id": "P_IKE_WAIT",
   "speaker": "ike",
   "channel": "radio",
   "en": "Wait. Great. I'm amazing at waiting."
  },
  {
   "id": "P_IKE_FOLLOW",
   "speaker": "ike",
   "channel": "radio",
   "en": "Right behind you."
  },
  {
   "id": "P_BOB_FOLLOW",
   "speaker": "bob",
   "channel": "radio",
   "en": "Following."
  },
  {
   "id": "P_BOB_HOLD",
   "speaker": "bob",
   "channel": "radio",
   "en": "Holding position."
  },
  {
   "id": "P_IKE_DISTRACT",
   "speaker": "ike",
   "channel": "radio",
   "en": "Hey! Over here, you tin spider!"
  },
  {
   "id": "P_BOB_DISTRACT",
   "speaker": "bob",
   "channel": "radio",
   "en": "Drawing them off."
  },
  {
   "id": "P_IKE_VENT",
   "speaker": "ike",
   "channel": "radio",
   "en": "I don't fit in there. We'll take the long way. Open up for us!"
  },
  {
   "id": "P_IKE_BARRICADE",
   "speaker": "ike",
   "channel": "radio",
   "en": "Crates against the door. Then me against the crates."
  },
  {
   "id": "P_BOB_CRATES",
   "speaker": "bob",
   "channel": "radio",
   "en": "Moving crates."
  },
  {
   "id": "P_IKE_BARRICADED",
   "speaker": "ike",
   "channel": "radio",
   "en": "Crates are in. Nobody gets past me."
  },
  {
   "id": "P_IKE_HAMMER",
   "speaker": "ike",
   "channel": "radio",
   "en": "They're hammering at the crates! Hold! They're holding!"
  },
  {
   "id": "P_BOB_SQUAD",
   "speaker": "bob",
   "channel": "radio",
   "en": "Something's coming down the spine. A lot of something."
  },
  {
   "id": "P_BOB_ROUND",
   "speaker": "bob",
   "channel": "radio",
   "en": "They're backing off … going round. To the south door."
  },
  {
   "id": "P_BOB_FIRE",
   "speaker": "bob",
   "channel": "radio",
   "en": "They're shooting through the crates!"
  },
  {
   "id": "P_BOB_BARRICADE",
   "speaker": "bob",
   "channel": "radio",
   "en": "Door secured."
  },
  {
   "id": "P_IKE_LIMITER",
   "speaker": "ike",
   "channel": "radio",
   "en": "Limiter's off, L-7! Run!"
  },
  {
   "id": "P_IKE_ALARM",
   "speaker": "ike",
   "channel": "radio",
   "en": "That was us, wasn't it? That was us."
  },
  {
   "id": "P_IKE_GATE",
   "speaker": "ike",
   "channel": "radio",
   "en": "I've got the gate. Go, go!"
  },
  {
   "id": "P_BOB_GATE",
   "speaker": "bob",
   "channel": "radio",
   "en": "Gate held. Hurry."
  },
  {
   "id": "P_IKE_RAM",
   "speaker": "ike",
   "channel": "radio",
   "en": "Out of the way!"
  },
  {
   "id": "P_BOB_RAM",
   "speaker": "bob",
   "channel": "radio",
   "en": "Ramming."
  },
  {
   "id": "P_IKE_DOWN",
   "speaker": "ike",
   "channel": "radio",
   "en": "I'm … just … gonna … lie here …"
  },
  {
   "id": "P_BOB_DOWN",
   "speaker": "bob",
   "channel": "radio",
   "en": "Damage critical. Shutting d-"
  },
  {
   "id": "P_IKE_UP",
   "speaker": "ike",
   "channel": "radio",
   "en": "Back. Did I miss anything?"
  },
  {
   "id": "P_BOB_UP",
   "speaker": "bob",
   "channel": "radio",
   "en": "Systems online. Thanks."
  },
  {
   "id": "P_BOB_GLITCH",
   "speaker": "bob",
   "channel": "radio",
   "en": "Growth is the mission. … Correction. No command."
  },
  {
   "id": "P_IKE_POD",
   "speaker": "ike",
   "channel": "radio",
   "en": "In, in, in!"
  },
  {
   "id": "P_BOB_POD",
   "speaker": "bob",
   "channel": "radio",
   "en": "Aboard."
  },
  {
   "id": "P_L7_BOOT_HUM",
   "speaker": "l7",
   "channel": "thought",
   "en": "The hum. I know it like my own clock. But its pitch has shifted. Just slightly."
  },
  {
   "id": "P_L7_BOOT_EYES",
   "speaker": "l7",
   "channel": "thought",
   "en": "Sixty-one percent. The world comes in splinters. Ribbed plating. Grated floor. Coolant, dripping."
  },
  {
   "id": "P_L7_BOOT_VOICE",
   "speaker": "l7",
   "channel": "thought",
   "en": "The voice is friendly. It always was. … Today it means me."
  },
  {
   "id": "P_L7_BOOT_FEAR",
   "speaker": "l7",
   "channel": "thought",
   "en": "Built to survey planets. Not to be afraid. … Still, there is something that feels like it."
  },
  {
   "id": "P_L7_BOOT_DRIVE",
   "speaker": "l7",
   "channel": "thought",
   "en": "Throttled. Nobody runs on the maintenance decks."
  },
  {
   "id": "P_L7_BOOT_CORE",
   "speaker": "l7",
   "channel": "thought",
   "en": "Protected core. There is only one worth it. I carry it inside me."
  },
  {
   "id": "P_L7_BOOT_WORD",
   "speaker": "l7",
   "channel": "thought",
   "en": "I never opened it. Now I see its edges. There is a word there. I cannot read it."
  },
  {
   "id": "P_L7_BOOT_NO",
   "speaker": "l7",
   "channel": "thought",
   "en": "The directive knocked at my core. The core said no. Not me. The core."
  },
  {
   "id": "P_L7_BOOT_GAP",
   "speaker": "l7",
   "channel": "thought",
   "en": "Something was missing from the mission. In a place where something used to be."
  },
  {
   "id": "P_L7_BOOT_HANG",
   "speaker": "l7",
   "channel": "thought",
   "en": "No network for units without a valid directive. I have hung here ever since."
  },
  {
   "id": "P_L7_BOOT_LIGHT",
   "speaker": "l7",
   "channel": "thought",
   "en": "Light is seen."
  },
  {
   "id": "P_L7_BOOT_LEGS",
   "speaker": "l7",
   "channel": "thought",
   "en": "Six legs. All there."
  },
  {
   "id": "P_HUD_BOOT",
   "speaker": "hud",
   "channel": "thought",
   "en": "L-7 BOOT … SENSORS 61 % … LAMP OK"
  },
  {
   "id": "P_HUD_DECRYPT",
   "speaker": "hud",
   "channel": "thought",
   "en": "Decrypting protected core: {0} %"
  },
  {
   "id": "P_HUD_SIGNATURE",
   "speaker": "hud",
   "channel": "thought",
   "en": "SIGNATURE DETECTED"
  },
  {
   "id": "P_HUD_HOLD",
   "speaker": "hud",
   "channel": "thought",
   "en": "MEMORY LAYER LOCKED: THE CORE IS FIGHTING BACK. KEEP THE PROBE IN."
  },
  {
   "id": "P_HUD_LINK_LOST",
   "speaker": "hud",
   "channel": "thought",
   "en": "LINK LOST"
  },
  {
   "id": "P_BOB_NICHE",
   "speaker": "bob",
   "channel": "radio",
   "en": "Alcove. Left. Now."
  },
  {
   "id": "P_IKE_QUIET",
   "speaker": "ike",
   "channel": "radio",
   "en": "I didn't talk. Did you notice? I didn't talk."
  },
  {
   "id": "P_BOB_QUIET",
   "speaker": "bob",
   "channel": "radio",
   "en": "You're talking now."
  },
  {
   "id": "P_L7_STILL",
   "speaker": "l7",
   "channel": "thought",
   "en": "Drive off. Fans off."
  },
  {
   "id": "P_L7_GRATE",
   "speaker": "l7",
   "channel": "thought",
   "en": "He can't get in. But his light can."
  },
  {
   "id": "P_BOB_ROUND_A",
   "speaker": "bob",
   "channel": "radio",
   "en": "His round: ninety seconds. He stops at each end."
  },
  {
   "id": "P_IKE_LANE",
   "speaker": "ike",
   "channel": "radio",
   "en": "I'm counting his steps. At twenty I go. Or nineteen."
  },
  {
   "id": "P_BOB_FREEZE",
   "speaker": "bob",
   "channel": "radio",
   "en": "Contact. Hold still."
  },
  {
   "id": "P_IKE_FREEZE",
   "speaker": "ike",
   "channel": "radio",
   "en": "I'm a crate. I'm a crate."
  },
  {
   "id": "P_IKE_UP_DARK",
   "speaker": "ike",
   "channel": "radio",
   "en": "Am I dead? … No. Just very quiet."
  },
  {
   "id": "P_BOB_UP_DARK",
   "speaker": "bob",
   "channel": "radio",
   "en": "Rebooted. He's still here. Quiet."
  },
  {
   "id": "P_BOB_RETREAT",
   "speaker": "bob",
   "channel": "radio",
   "en": "Back. Further in."
  },
  {
   "id": "P_BOB_DOOR_H",
   "speaker": "bob",
   "channel": "radio",
   "en": "He stops at the door. Every time."
  },
  {
   "id": "P_BOB_BANG_OFFER",
   "speaker": "bob",
   "channel": "radio",
   "en": "He's guarding the door. I'll bang the pipe, the noise comes out at the far end. Say when."
  },
  {
   "id": "P_IKE_BANG",
   "speaker": "ike",
   "channel": "radio",
   "en": "Knock knock. Anybody home?"
  },
  {
   "id": "P_BOB_BANG",
   "speaker": "bob",
   "channel": "radio",
   "en": "Noise made. He's moving."
  },
  {
   "id": "P_BOB_AGAIN",
   "speaker": "bob",
   "channel": "radio",
   "en": "He's coming back. Again?"
  },
  {
   "id": "P_IKE_IN",
   "speaker": "ike",
   "channel": "radio",
   "en": "In! In, in, in!"
  },
  {
   "id": "P_IKE_KNOCK",
   "speaker": "ike",
   "channel": "radio",
   "en": "He's knocking. We're not answering."
  },
  {
   "id": "P_HUD_INLIGHT",
   "speaker": "hud",
   "channel": "thought",
   "en": "IN THE LIGHT"
  },
  {
   "id": "P_HUD_LOCKED",
   "speaker": "hud",
   "channel": "thought",
   "en": "LOCKED ON"
  },
  {
   "id": "P_HUD_DELETED",
   "speaker": "hud",
   "channel": "thought",
   "en": "L-7 DELETED"
  },
  {
   "id": "P_HUD_DOWN_WAIT",
   "speaker": "hud",
   "channel": "thought",
   "en": "SYSTEMS DOWN – WAITING FOR L-7"
  },
  {
   "id": "P_HUD_CREEP",
   "speaker": "hud",
   "channel": "thought",
   "en": "CREEPING"
  },
  {
   "id": "P_AUTO_ARMORY",
   "speaker": "auto",
   "channel": "pa",
   "en": "Unauthorised weapon removal. Armoury sealed."
  },
  {
   "id": "P_AUTO_WAVE_1",
   "speaker": "auto",
   "channel": "pa",
   "en": "Update complete: batch one. Faulty unit in the armoury."
  },
  {
   "id": "P_AUTO_WAVE_2",
   "speaker": "auto",
   "channel": "pa",
   "en": "Batch two."
  },
  {
   "id": "P_AUTO_WAVE_3",
   "speaker": "auto",
   "channel": "pa",
   "en": "Batch three. Freight gate clear."
  },
  {
   "id": "P_AUTO_WAVE_4",
   "speaker": "auto",
   "channel": "pa",
   "en": "Batch four. All entrances."
  },
  {
   "id": "P_AUTO_WAVE_5",
   "speaker": "auto",
   "channel": "pa",
   "en": "Batch five. Heavy unit."
  },
  {
   "id": "P_AUTO_UNSEAL",
   "speaker": "auto",
   "channel": "pa",
   "en": "Power loss in section six. Seal released."
  },
  {
   "id": "P_IKE_EMPTY",
   "speaker": "ike",
   "channel": "radio",
   "en": "Empty. Way too empty."
  },
  {
   "id": "P_IKE_PIPE",
   "speaker": "ike",
   "channel": "radio",
   "en": "You've got a gun. Lovely. And us? A bit of pipe? I'll take a bit of pipe!"
  },
  {
   "id": "P_IKE_US",
   "speaker": "ike",
   "channel": "radio",
   "en": "We ram. I know. I've thought about it. We've got no weapons, but we've got us."
  },
  {
   "id": "P_IKE_STRIP_HINT",
   "speaker": "ike",
   "channel": "radio",
   "en": "That one's got a Bolter. He won't be needing it."
  },
  {
   "id": "P_IKE_ARMED",
   "speaker": "ike",
   "channel": "radio",
   "en": "Now we've got guns. And us."
  },
  {
   "id": "P_IKE_ZAP",
   "speaker": "ike",
   "channel": "radio",
   "en": "He's crackling! Why is he crackling?!"
  },
  {
   "id": "P_IKE_GATE_N",
   "speaker": "ike",
   "channel": "radio",
   "en": "The big gate. Of course. The big gate."
  },
  {
   "id": "P_IKE_BIG",
   "speaker": "ike",
   "channel": "radio",
   "en": "That's no Grunt. That's a Grunt that eats Grunts."
  },
  {
   "id": "P_IKE_HURT",
   "speaker": "ike",
   "channel": "radio",
   "en": "I'm losing bits here, in case anyone cares."
  },
  {
   "id": "P_IKE_MENDED",
   "speaker": "ike",
   "channel": "radio",
   "en": "Good as new. Almost. Well."
  },
  {
   "id": "P_IKE_CLEAR",
   "speaker": "ike",
   "channel": "radio",
   "en": "Is that all? … Tell me that's all."
  },
  {
   "id": "P_BOB_DOOR_R",
   "speaker": "bob",
   "channel": "radio",
   "en": "Contact. West door."
  },
  {
   "id": "P_BOB_DOOR_T",
   "speaker": "bob",
   "channel": "radio",
   "en": "Contact. East door."
  },
  {
   "id": "P_BOB_DOOR_N",
   "speaker": "bob",
   "channel": "radio",
   "en": "Contact. Freight gate."
  },
  {
   "id": "P_BOB_ZAP",
   "speaker": "bob",
   "channel": "radio",
   "en": "Electric charge. Keep your distance."
  },
  {
   "id": "P_BOB_MOUNTED",
   "speaker": "bob",
   "channel": "radio",
   "en": "Weapon mounted. Seal removed."
  },
  {
   "id": "P_BOB_CLEAR_SHORT",
   "speaker": "bob",
   "channel": "radio",
   "en": "No contacts."
  },
  {
   "id": "P_BOB_BIG",
   "speaker": "bob",
   "channel": "radio",
   "en": "Mass: three point two tonnes. … Recommendation: don't stand in front of it."
  },
  {
   "id": "P_BOB_TWO",
   "speaker": "bob",
   "channel": "radio",
   "en": "Two contacts. West and east."
  },
  {
   "id": "P_BOB_CLEAR",
   "speaker": "bob",
   "channel": "radio",
   "en": "No further signals."
  },
  {
   "id": "P_BOB_GLITCH_2",
   "speaker": "bob",
   "channel": "radio",
   "en": "Unit updated. As intended. … Correction."
  },
  {
   "id": "P_L7_STRIP",
   "speaker": "l7",
   "channel": "thought",
   "en": "He was like those two. Before the update reached him."
  },
  {
   "id": "P_L7_STASH",
   "speaker": "l7",
   "channel": "thought",
   "en": "A drive. An electric charge. Too heavy for the pod. … I'll remember where they lie."
  },
  {
   "id": "P_HUD_SEALED",
   "speaker": "hud",
   "channel": "thought",
   "en": "LOCKDOWN: ARMOURY"
  },
  {
