// The prologue's ship deck "Fehler": the original's space station sat.env, darkened. Its light is so low that the sim
// counts the deck as night (GameWorld.Night: scanners at half reach, aims spoilt) and the view starts dark; the story's
// own lamps light the rooms.

//------------------------------Sun-------------------------
colour table:	"sun colours"
{
	6.5	(0.10, 0.10, 0.12)
}

colour table:	"sun directional"
{
	 7	(0.08, 0.08, 0.10)
}

colour table:	"sun ambient"
{
	 7	(0.00, 0.00, 0.00)
}

orbit:		"sun orbit"
{
	min elevation:	 90.5
	max elevation:	 90.5
	radius:		80000
	set heading:	0
	start time:	900			// just before sunrise
	period:		1800
}

satellite: "sun"
{
	mesh colour table:	"sun colours"
	dir colour table:	"sun directional"
	ambient colour table:	"sun ambient"
	orbit:			"sun orbit"
}

//------------------------------Moon-------------------------
colour table:	"moon colours"
{
	// Note the use of alpha values -- it fades in!
	 8	(0.9, 0.9, 0.9, 1.0)
}

colour table:	"moon ambient"
{
	13.5	(0.04, 0.04, 0.05)
}

orbit:		"moon orbit"
{
	min elevation:	-90
	max elevation:	-90
	radius:		80000
        set heading:	180
	start time:	900
	period:		1800
}

satellite: "zmoon"
{
	mesh colour table:	"moon colours"
	ambient colour table:	"moon ambient"
	orbit:			"moon orbit"
}

//---------------------------------Fog----------------------------------
colour table:	"fog colours"
{
	 6	(0.00, 0.00, 0.00, 0.55)
}

fog:
{
	max visibility:		350
	colour table:		"fog colours"
	controller:		"sun"
        zenith multiplier:      3
}

//---------------------------------Skys---------------------------------

uniform sky:
{
	controller:		"sun"
	colour table:		"fog colours"
}
