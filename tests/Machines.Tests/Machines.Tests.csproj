<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The tests may ask by race for the race's first player (PlayerId.RaceForm); the sim and the net may not. -->
    <NoWarn>$(NoWarn);MACHINES0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The relay's web side (RelayHttp, Kestrel) runs in the tests; the relay keeps its own reference private. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\import\Machines.Import\Machines.Import.csproj" />
    <ProjectReference Include="..\..\sim\Machines.Sim\Machines.Sim.csproj" />
    <ProjectReference Include="..\..\net\Machines.Net\Machines.Net.csproj" />
    <ProjectReference Include="..\..\server\Machines.Relay\Machines.Relay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Godot-free on purpose, so what a hero's model is made of, its making and the profile can be tested here. -->
    <Compile Include="..\..\game\scripts\HeroParts.cs" Link="Sim\HeroParts.cs" />
    <Compile Include="..\..\game\scripts\HeroSeat.cs" Link="Sim\HeroSeat.cs" />
    <Compile Include="..\..\game\scripts\HeroDraft.cs" Link="Sim\HeroDraft.cs" />
    <Compile Include="..\..\game\scripts\WiredProfile.cs" Link="Sim\WiredProfile.cs" />
    <Compile Include="..\..\game\scripts\BattleAccount.cs" Link="Sim\BattleAccount.cs" />
    <Compile Include="..\..\game\scripts\BattleDraft.cs" Link="Sim\BattleDraft.cs" />
    <Compile Include="..\..\game\scripts\WiredReport.cs" Link="Sim\WiredReport.cs" />
    <Compile Include="..\..\game\scripts\HangarShop.cs" Link="Sim\HangarShop.cs" />
    <Compile Include="..\..\game\scripts\HangarWatch.cs" Link="Sim\HangarWatch.cs" />
    <Compile Include="..\..\game\scripts\HangarFrame.cs" Link="Sim\HangarFrame.cs" />
    <Compile Include="..\..\game\scripts\HeroHull.cs" Link="Sim\HeroHull.cs" />
    <Compile Include="..\..\game\scripts\HangarGlyphs.cs" Link="Sim\HangarGlyphs.cs" />
    <Compile Include="..\..\game\scripts\WiredReadout.cs" Link="Sim\WiredReadout.cs" />
    <Compile Include="..\..\game\scripts\GunPrediction.cs" Link="Sim\GunPrediction.cs" />
    <Compile Include="..\..\game\scripts\BattleReadout.cs" Link="Sim\BattleReadout.cs" />
    <Compile Include="..\..\game\scripts\RoomOptions.cs" Link="Net\RoomOptions.cs" />
    <Compile Include="..\..\game\scripts\WeaponTriggers.cs" Link="Sim\WeaponTriggers.cs" />
    <Compile Include="..\..\game\scripts\KeyClash.cs" Link="Sim\KeyClash.cs" />
    <Compile Include="..\..\game\scripts\GameLocator.cs" Link="Import\GameLocator.cs" />
    <Compile Include="..\..\game\scripts\GameDisc.cs" Link="Import\GameDisc.cs" />
  </ItemGroup>

</Project>
